# Copiá este archivo a .env.local para probar en tu compu.
# En Vercel se cargan en Settings > Environment Variables, una por una.

# Cualquier texto largo y difícil de adivinar, mínimo 32 caracteres. Firma la cookie de sesión.
SESSION_SECRET=

# Códigos de acceso, uno por persona, separados por coma. Cada código es la identidad.
# Ejemplo: ACCESS_CODES=palabra-larga-de-octavio,otra-palabra-para-mama
ACCESS_CODES=

# Cloudflare R2. Si faltan, el sitio anda en modo demo con public/demo/muestra.mp4.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fuego-tiene
