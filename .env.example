# Copiá este archivo a .env.local para probar en tu compu.
# En Vercel se cargan en Settings > Environment Variables, una por una.

# La única obligatoria. Cualquier texto largo y difícil de adivinar, mínimo 32
# caracteres: firma la cookie de la sesión y la del pase del juego.
SESSION_SECRET=

# Opcional, y hoy casi sin uso: al sitio se entra sin contraseña y los
# capítulos se ganan en el juego. Un código de acá entra igual, pero tiene que
# jugar como todos. Separados por coma.
# Ejemplo: ACCESS_CODES=palabra-larga-de-octavio,otra-palabra-para-mama
ACCESS_CODES=

# Opcional. Los códigos que ven los capítulos sin pasar por el juego. Nada
# más: no llegan a /estado ni a /subir.
# Ejemplo: CODIGOS_LIBRES=palabra-para-mirar-la-serie
CODIGOS_LIBRES=

# Opcional. Tu código: el único que además entra a /estado y a /subir, o sea
# a mirar el bucket y a escribir en él. Entra sin jugar, como los de arriba.
# Ejemplo: CODIGOS_DUENO=palabra-larga-de-octavio
CODIGOS_DUENO=

# Opcional. Cuánto hay que sacar en el juego, sobre 100, para que se abran los
# capítulos. Por defecto 70. Más abajo de 55 entra casi cualquier plan; más
# arriba de 85 hay que escribir un operativo muy completo.
PUNTAJE_PARA_ENTRAR=

# Cloudflare R2. Si faltan, el sitio anda en modo demo con public/demo/muestra.mp4.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fuego-tiene

# No hay ninguna otra variable. El sitio no llama a ninguna API paga: el
# desenlace del juego lo escribe código local, y el video sale de R2, que no
# cobra por lo que se baja. Con el plan gratis de Vercel y el de R2, esto no
# cuesta nada.
